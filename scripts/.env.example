# Copy this file to `.env` in the same directory and fill in real values.
# .env is gitignored and never committed.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The SECRET key (formerly "service_role"). NOT the publishable/anon key.
# Find it at: Supabase Project → Settings → API → "service_role" / "secret" key.
# This key bypasses RLS — keep it private, never commit, never put in client code.
SUPABASE_SERVICE_KEY=eyJhbGciOi...
