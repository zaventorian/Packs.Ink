# Secrets — never commit
scripts/.env
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Editor / agent config
.vscode/
.idea/
.claude/

# Backfill working dir (large)
scripts/backfill_cache/

# Ravensburger media-kit originals + extracted assets — 3.3 GB, kept on
# disk but never committed. Only the curated subset under Logos/ ships.
Art Assets/

# Loader / audit script local outputs — regenerable, not source.
scripts/sealed_dryrun*.txt
scripts/*_audit.csv
# Scratch run logs + downloaded test images from the graded/OCR scripts.
scripts/_*.log
scripts/_*.jpg
# OCR slab-audit runtime state: resume checkpoint + the manual-review mismatch list.
scripts/_ocr_done.txt
scripts/_ocr_mismatches.csv

# Terapeak scraper — session state (live cookies, treat as secrets) +
# scraped output and HTML snapshots (large, regenerable).
scripts/.terapeak_state.json
scripts/terapeak_output/
scripts/terapeak_snapshots/

# Source-image dump for card art (already copied into Logos/cards/ when used).
Photo Dumb/

# Design source files. .ai / large .pdf source files for logos are kept
# locally only — they're 18+ MB binaries and the site only consumes the
# rendered PNGs (regenerable via scripts/convert_logo.py).
Logos/*.ai
Logos/*.pdf

# Local ELO SQLite DB — ~6 MB binary, source-of-truth lives in Supabase
# Storage (bucket: elo, key: lorcana_elo.db). The weekly refresh workflow
# pulls/pushes it from there. Never commit.
scripts/elo/lorcana_elo.db
scripts/elo/lorcana_elo_preview.db

# Discovery scratch — regenerable JSON outputs from the various discover_*.py
# scripts. Keep the *scripts* in git, drop the working dumps (they're large,
# session-specific, and easily re-generated).
scripts/elo/inklands_candidates.json
scripts/elo/inklands_scs.json
scripts/elo/inklands_to_ingest.txt
scripts/elo/missing_scs_melee.json
scripts/elo/missing_rph_scs.json
scripts/elo/rph_missing_*.json
scripts/elo/rph_to_ingest.json
scripts/elo/rph_wu_first_weekend.json
scripts/elo/final_audit_*.json
scripts/elo/xref_*.json
scripts/elo/wu_queue.json
scripts/elo/wu_scs_upcoming.json

# Local dev server log + favicon source backups (regenerable).
dev_server.log
*.bak
scripts/elo/elo_tracked_stores.json

# Bulk TCGplayer sales-history capture (large, regenerable via scrape_tcgplayer_sales.py).
scripts/tcg_sales/out/

# Ad-hoc HTTP response dumps from API probing (debug scratch).
response_body.txt
response_headers.txt

# Card scanner: cached Lorcast source images (~150MB) + synthetic query renders.
# Regenerable via scripts/scanner/fetch_cards.py. The shipped descriptor index
# (repo-root scanner/*.bin + index.json) is NOT ignored — it's the artifact the PWA loads.
scripts/scanner/data/img/
scripts/scanner/data/queries/
scripts/scanner/data/cards.json
# Local-only QA harness for the JS matcher (needs the gitignored image cache;
# would ship a broken public page if deployed).
scanner-test.html
