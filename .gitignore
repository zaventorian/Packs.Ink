# Secrets — never commit
scripts/.env
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Editor / agent config
.vscode/
.idea/
.claude/

# Backfill working dir (large)
scripts/backfill_cache/

# Ravensburger media-kit originals + extracted assets — 3.3 GB, kept on
# disk but never committed. Only the curated subset under Logos/ ships.
Art Assets/

# Loader / audit script local outputs — regenerable, not source.
scripts/sealed_dryrun*.txt
scripts/*_audit.csv

# Terapeak scraper — session state (live cookies, treat as secrets) +
# scraped output and HTML snapshots (large, regenerable).
scripts/.terapeak_state.json
scripts/terapeak_output/
scripts/terapeak_snapshots/

# Source-image dump for card art (already copied into Logos/cards/ when used).
Photo Dumb/

# Design source files. .ai / large .pdf source files for logos are kept
# locally only — they're 18+ MB binaries and the site only consumes the
# rendered PNGs (regenerable via scripts/convert_logo.py).
Logos/*.ai
Logos/*.pdf

# Local ELO SQLite DB — ~6 MB binary, source-of-truth lives in Supabase
# Storage (bucket: elo, key: lorcana_elo.db). The weekly refresh workflow
# pulls/pushes it from there. Never commit.
scripts/elo/lorcana_elo.db
scripts/elo/lorcana_elo_preview.db

# Inklands discovery scratch — regenerable by re-running discover_inklands.py.
# Keep the *scripts* in git, drop the working JSON / tid-list output.
scripts/elo/inklands_candidates.json
scripts/elo/inklands_scs.json
scripts/elo/inklands_to_ingest.txt

# Local dev server log + favicon source backups (regenerable).
dev_server.log
*.bak
