# Netlify SPA fallback — every path that isn't an existing file serves
# Index.html so client-side path routing works for deep links like
# packs.ink/decks, packs.ink/screener, packs.ink/analytics, etc.
#
# Folders preserved by listing them first so they still serve their own
# files (images, supabase migration text, etc.) instead of falling through.
/Logos/*  /Logos/:splat  200
/scripts/*  /scripts/:splat  200
/supabase/*  /supabase/:splat  200

# Everything else falls through to Index.html with HTTP 200, leaving the
# original path in window.location.pathname so the app can parse it.
/*  /Index.html  200
